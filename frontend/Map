.point-card:hover  { background: rgb(35, 39, 42); }
.point-card.active { background: rgb(35, 39, 42); border-left: 3px solid rgb(46, 204, 113); }

.point-name    { font-size: 14px; font-weight: 600; color: rgb(255, 255, 255); margin-bottom: 4px; line-height: 1.3; }
.point-address { font-size: 12px; color: rgb(138, 138, 138); margin-bottom: 8px; }
.point-hours   { font-size: 11px; color: rgb(138, 138, 138); }

.point-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-bottom: 8px;
}
.point-tags span {
    padding: 3px 8px;
    background: rgb(42, 46, 48);
    color: rgb(46, 204, 113);
    border-radius: 4px;
    font-size: 10px;
