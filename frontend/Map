/* ---------- 3.2. Карта ---------- */
#map {
    flex: 1;
    height: 100%;
    background: rgb(26, 29, 31);
}
.leaflet-tile { filter: brightness(0.7) contrast(1.1); }

.custom-marker {
    width: 18px; height: 18px;
    background: rgb(46, 204, 113);
    border: 2px solid rgb(17, 17, 17);
    border-radius: 50%;
    box-shadow: 0 0 8px rgba(46, 204, 113, 0.8);
