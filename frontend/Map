}

/* ---------- 3.3. Всплывающее окно на карте ---------- */
.leaflet-popup-content-wrapper {
    background: rgb(26, 29, 31);
    color: rgb(232, 232, 232);
    border-radius: 8px;
    border: 1px solid rgb(42, 46, 48);
}
.leaflet-popup-tip { background: rgb(26, 29, 31); }

.popup-title    { font-size: 14px; font-weight: bold; margin-bottom: 6px; color: rgb(255, 255, 255); }
.popup-address  { font-size: 12px; color: rgb(138, 138, 138); margin-bottom: 8px; }
.popup-hours    { font-size: 11px; color: rgb(176, 176, 176); }
.popup-desc     { font-size: 11px; color: rgb(138, 138, 138); margin-top: 6px; line-height: 1.4; }

.popup-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-bottom: 6px;
}
.popup-tags span {
    padding: 2px 6px;
    background: rgb(42, 46, 48);
    color: rgb(46, 204, 113);
    border-radius: 3px;
    font-size: 10px;
}

.popup-delete {
    margin-top: 8px;
    padding: 4px 10px;
    background: rgb(231, 76, 60);
    color: rgb(255, 255, 255);
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-size: 11px;
}
</style>
</head>
