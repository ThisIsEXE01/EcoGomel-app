}
.actions button {
    flex: 1;
    padding: 8px;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    font-size: 12px;
    font-weight: 600;
    transition: 0.2s;
}
.actions button:hover { opacity: 0.85; }

#addModeBtn              { background: rgb(46, 204, 113); color: rgb(17, 17, 17); }
#addModeBtn.active       { background: rgb(243, 156, 18); color: rgb(255, 255, 255); }
#clearAllBtn             { background: rgb(231, 76, 60); color: rgb(255, 255, 255); }

