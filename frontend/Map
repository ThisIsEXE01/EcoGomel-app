<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<title>ЭкоГомель — карта пунктов приёма вторсырья</title>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<style>
/* ============================================================
   1. БАЗОВЫЕ СТИЛИ И СБРОС
   ============================================================ */
* { margin: 0; padding: 0; box-sizing: border-box; }

body {
    font-family: 'Segoe UI', Arial, sans-serif;
    background: rgb(26, 29, 31);
    color: rgb(232, 232, 232);
    display: flex;
    flex-direction: column;
    height: 100vh;
    overflow: hidden;
}

/* ============================================================
   2. ШАПКА САЙТА
   ============================================================ */
header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 24px;
    background: rgb(17, 20, 21);
    border-bottom: 1px solid rgb(42, 46, 48);
}
.logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 18px;
    font-weight: bold;
    color: rgb(255, 255, 255);
}
.logo-icon {
    width: 30px; height: 30px;
    background: rgb(46, 204, 113);
    border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    font-size: 16px;
}
nav a {
    color: rgb(176, 176, 176);
    text-decoration: none;
    margin-left: 24px;
    font-size: 14px;
}
nav a:hover { color: rgb(46, 204, 113); }

/* ============================================================
   3. ОСНОВНАЯ ОБЛАСТЬ (сайдбар + карта)
   ============================================================ */
.main { display: flex; flex: 1; overflow: hidden; }

/* ---------- 3.1. Левая панель ---------- */
#sidebar {
    width: 340px;
    background: rgb(26, 29, 31);
    border-right: 1px solid rgb(42, 46, 48);
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

/* Строка поиска */
.search-box {
    padding: 14px;
    border-bottom: 1px solid rgb(42, 46, 48);
}
.search-box input {
    width: 100%;
    padding: 10px 12px;
    background: rgb(35, 39, 42);
    border: 1px solid rgb(42, 46, 48);
    border-radius: 6px;
    color: rgb(232, 232, 232);
    font-size: 13px;
}
.search-box input:focus {
    outline: none;
    border-color: rgb(46, 204, 113);
}

/* Кнопки-фильтры */
.filters {
    padding: 12px 14px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    border-bottom: 1px solid rgb(42, 46, 48);
