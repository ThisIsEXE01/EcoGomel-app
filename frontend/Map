  { id:17, name:"Эко-контейнер в «Евроопт» (Свиридова)", address:"г. Гомель, ул. Свиридова, 15-1", latitude:52.4746, longitude:31.0255, accepted_types:["Батарейки","Ртутные лампы"], working_hours:"Пн-Вс 09:00-22:00", description:"Пункт сбора батареек и ламп в Клёнковском." },
  { id:18, name:"Эко-контейнер в ТЦ «МАНДАРИН ПЛАЗА»", address:"г. Гомель, Речицкий проспект, 5В", latitude:52.4056, longitude:30.9381, accepted_types:["Батарейки","Ртутные лампы"], working_hours:"Пн-Вс 10:00-21:00", description:"Эко-контейнер для ртутьсодержащих ламп и батареек." }
];


/* ############################################################
   #                                                          #
   #   2. КОНФИГУРАЦИЯ (для будущего подключения к API)       #
   #                                                          #
   ############################################################ */

/* 'local' — данные в localStorage браузера.
   'api'   — данные приходят с сервера по API_URL.
   Когда появится сервер — поменяй на 'api'. */
const DATA_SOURCE = 'local';

/* Адрес API сервера (когда он появится) */
const API_URL = 'http://localhost:8000/api/v1/points';

/* Ключ для localStorage */
const LS_KEY = 'ecogomel_points';


/* ############################################################
   #                                                          #
   #   3. РАБОТА С ДАННЫМИ                                    #
   #   (заглушка API — при переходе на сервер меняется только #
   #    содержимое этих функций, остальной код не трогается)  #
   #                                                          #
   ############################################################ */

/** Получить все точки (с сервера или из localStorage). */
async function getPoints() {
    if (DATA_SOURCE === 'api') {
        const res = await fetch(API_URL);
        return await res.json();
    }

    // Локальный режим:
    // 1) если уже что-то есть в localStorage — вернуть его;
    // 2) иначе взять стартовый набор.
    const saved = localStorage.getItem(LS_KEY);
    if (saved) return JSON.parse(saved);

    return JSON.parse(JSON.stringify(INITIAL_POINTS));
}

/** Сохранить массив точек в localStorage (только для local). */
function savePointsLocal(list) {
    if (DATA_SOURCE === 'local') {
        localStorage.setItem(LS_KEY, JSON.stringify(list));
    }
}

/** Добавить точку — на сервер (POST) или локально. */
async function apiAddPoint(point) {
    if (DATA_SOURCE === 'api') {
        const res = await fetch(API_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(point)
        });
        return await res.json();   // сервер вернёт с настоящим id
    }

    point.id = Date.now();         // локально — id по времени
    return point;
}

/** Удалить точку — на сервере (DELETE) или локально (просто пропуск). */
async function apiDeletePoint(id) {
    if (DATA_SOURCE === 'api') {
        await fetch(`${API_URL}/${id}`, { method: 'DELETE' });
    }
    // В локальном режиме сервера нет — удаление из массива делает вызывающий код
}


/* ############################################################
   #                                                          #
   #   4. СОСТОЯНИЕ ПРИЛОЖЕНИЯ                                #
   #                                                          #
   ############################################################ */

let points = [];              // массив всех точек
const markerMap = {};         // { id: Leaflet-маркер }
let activeFilter = 'all';     // текущий фильтр
let searchText = '';          // текущий поисковый запрос
let addMode = false;          // включён ли режим добавления


/* ############################################################
   #                                                          #
   #   5. КАРТА LEAFLET                                       #
   #                                                          #
   ############################################################ */

const map = L.map('map', { zoomControl: false })
    .setView([52.4345, 30.9754], 12);   // центр Гомеля

L.tileLayer('https://{s}.tile.openstreetmap.fr/hot/{z}/{x}/{y}.png', {
    maxZoom: 19,
    subdomains: 'abc',
    attribution: '&copy; OpenStreetMap'
}).addTo(map);

L.control.zoom({ position: 'topright' }).addTo(map);

/* Кастомная иконка маркера (зелёный круг) */
const greenIcon = L.divIcon({
    className: '',
    html: '<div class="custom-marker"></div>',
    iconSize:    [18, 18],
    iconAnchor:  [9, 9],
    popupAnchor: [0, -10]
});


/* ############################################################
   #                                                          #
   #   6. МАРКЕРЫ                                             #
   #                                                          #
   ############################################################ */

/** Создать маркер для одной точки и добавить его на карту. */
function addMarker(p) {
    const marker = L.marker([p.latitude, p.longitude], { icon: greenIcon }).addTo(map);
    marker.bindPopup(buildPopup(p));
    marker.on('click', () => highlightCard(p.id));
    markerMap[p.id] = marker;
}

/** Сформировать HTML содержимое всплывающего окна. */
function buildPopup(p) {
    const tags = (p.accepted_types || [])
        .map(t => `<span>${t}</span>`)
        .join('');

    return `
        <div style="min-width:220px">
            <div class="popup-title">${p.name}</div>
            <div class="popup-address">${p.address}</div>
            <div class="popup-tags">${tags}</div>
            <div class="popup-hours">${p.working_hours}</div>
            <div class="popup-desc">${p.description || ''}</div>
            <button class="popup-delete" onclick="deletePoint(${p.id})">
                Удалить точку
            </button>
        </div>
    `;
}


/* ############################################################
   #                                                          #
   #   7. СПИСОК ТОЧЕК (левая панель)                         #
   #                                                          #
   ############################################################ */

const listEl = document.getElementById('points-list');

/** Перерисовать список с учётом фильтра и поиска. */
function renderList() {
    const filtered = points.filter(p => {
        const matchType = activeFilter === 'all' ||
            (p.accepted_types || []).some(t =>
                t.toLowerCase().includes(activeFilter.toLowerCase()));

        const matchText = searchText === '' ||
            p.name.toLowerCase().includes(searchText) ||
            p.address.toLowerCase().includes(searchText);

        return matchType && matchText;
    });

    listEl.innerHTML = '';

    // Если ничего не найдено — показать сообщение
    if (filtered.length === 0) {
        listEl.innerHTML =
            '<div style="padding:20px;color:rgb(138,138,138);text-align:center">' +
            'Ничего не найдено</div>';
        return;
    }

    // Отрисовать карточки
    filtered.forEach(p => {
        const card = document.createElement('div');
        card.className = 'point-card';
        card.dataset.id = p.id;

        const tags = (p.accepted_types || []).slice(0, 4)
            .map(t => `<span>${t}</span>`).join('');

        card.innerHTML = `
            <div class="point-name">${p.name}</div>
            <div class="point-address">${p.address}</div>
            <div class="point-tags">${tags}</div>
            <div class="point-hours">${p.working_hours}</div>
        `;

        // Клик по карточке — перелёт к точке и открытие попапа
        card.addEventListener('click', () => {
            map.setView([p.latitude, p.longitude], 15);
            markerMap[p.id].openPopup();
            highlightCard(p.id);
        });

        listEl.appendChild(card);
    });
}

/** Подсветить карточку точки (при клике на карте или в списке). */
function highlightCard(id) {
    document.querySelectorAll('.point-card')
        .forEach(c => c.classList.remove('active'));

    const card = document.querySelector(`.point-card[data-id="${id}"]`);
    if (card) {
        card.classList.add('active');
        card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
}


/* ############################################################
   #                                                          #
   #   8. ДОБАВЛЕНИЕ ТОЧКИ                                    #
   #                                                          #
   ############################################################ */

const addModeBtn = document.getElementById('addModeBtn');

addModeBtn.addEventListener('click', function () {
    addMode = !addMode;
    this.classList.toggle('active', addMode);
    this.textContent = addMode ? '📍 Кликните на карту' : '➕ Добавить точку';
});

/* Клик по карте в режиме добавления */
map.on('click', async function (e) {
    if (!addMode) return;

    const name = prompt('Название точки:');
    if (!name) return;

    const newPoint = {
        name:           name,
        address:        prompt('Адрес:') || '—',
        latitude:       e.latlng.lat,
        longitude:      e.latlng.lng,
        accepted_types: (prompt('Что принимают (через запятую):') || '')
                            .split(',').map(s => s.trim()).filter(Boolean),
        working_hours:  prompt('Часы работы:') || '—',
        description:    prompt('Описание:') || ''
    };

    const saved = await apiAddPoint(newPoint);
    points.push(saved);
    savePointsLocal(points);

    addMarker(saved);
    renderList();

    // Выйти из режима добавления
    addMode = false;
    addModeBtn.classList.remove('active');
    addModeBtn.textContent = '➕ Добавить точку';
});


/* ############################################################
   #                                                          #
   #   9. УДАЛЕНИЕ ТОЧКИ                                      #
   #                                                          #
   ############################################################ */

/** Удалить одну точку (по клику в попапе). */
async function deletePoint(id) {
    if (!confirm('Удалить эту точку?')) return;

    // Убрать маркер с карты
    if (markerMap[id]) {
        map.removeLayer(markerMap[id]);
        delete markerMap[id];
    }

    await apiDeletePoint(id);

    // Убрать из массива
    points = points.filter(p => p.id !== id);
    savePointsLocal(points);

    renderList();
}

/* Сделать функцию доступной из HTML (onclick внутри попапа) */
window.deletePoint = deletePoint;

/* Кнопка «Удалить все» */
document.getElementById('clearAllBtn').addEventListener('click', async function () {
    if (!confirm('Удалить ВСЕ точки с карты?')) return;

    // Удалить на сервере (в local — просто пропустится)
    for (const p of points) await apiDeletePoint(p.id);

    // Убрать маркеры с карты
    Object.values(markerMap).forEach(m => map.removeLayer(m));
    Object.keys(markerMap).forEach(k => delete markerMap[k]);

    points = [];
    savePointsLocal(points);
    renderList();
});


/* ############################################################
   #                                                          #
   #   10. ФИЛЬТРЫ И ПОИСК                                    #
   #                                                          #
   ############################################################ */

document.querySelectorAll('#filters button').forEach(btn => {
    btn.addEventListener('click', () => {
        document.querySelectorAll('#filters button')
            .forEach(b => b.classList.remove('active'));

        btn.classList.add('active');
        activeFilter = btn.dataset.type;
        renderList();
    });
});

document.getElementById('searchInput').addEventListener('input', e => {
    searchText = e.target.value.trim().toLowerCase();
    renderList();
});


/* ############################################################
   #                                                          #
   #   11. ЗАПУСК ПРИЛОЖЕНИЯ                                  #
   #                                                          #
   ############################################################ */

(async function init() {
    points = await getPoints();
    points.forEach(p => addMarker(p));
    renderList();
})();
</script>
