# Скопируйте этот файл в backend/.env и заполните значения.
# Файл backend/.env не коммитится в git.

# --- Локальная разработка ---
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=django-insecure-local-dev-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_CORS_ALLOWED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=False

# --- PythonAnywhere (production) ---
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=<сгенерированный ключ>
# DJANGO_ALLOWED_HOSTS=USERNAME.pythonanywhere.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://USERNAME.pythonanywhere.com
# DJANGO_CORS_ALLOWED_ORIGINS=
# DJANGO_SECURE_SSL_REDIRECT=True
